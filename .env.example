# npm run setup generates .env with unique credentials; edit before first startup.
APP_ORIGIN=http://localhost:3016
APP_LANGUAGE=en
APP_CURRENCY=USD
POSTGRES_PASSWORD=replace-with-random-hex
DATABASE_URL=postgres://tallybear:replace-with-random-hex@127.0.0.1:5439/tallybear
ENCRYPTION_KEY=replace-with-32-byte-base64-key
ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_PASSWORD=replace-with-a-private-password
RECEIPT_DIR=./data/receipts
